# Порт для работы сервера (по умолчанию 3001)
PORT=3001
API_PORT=3001

# Секретный ключ для входа в панель администратора (/admin)
# Задайте сложный пароль/токен
ADMIN_TOKEN=your_super_secret_admin_token_here

# Токен вашего Telegram-бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram ID администраторов через запятую (кому бот присылает уведомления о новых заказах)
# Узнать свой ID можно через бота @userinfobot
ADMIN_TELEGRAM_IDS=5224947292

# Разрешенные CORS origin (для локальной разработки, необязательно в production)
# CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
